# ======================
# BEPO Environment Variables
# ======================

# Coinbase Developer Platform (for x402 facilitator)
# Get from: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Receiving wallet for x402 payments (your address on Base)
EVM_ADDRESS=0xYourWalletAddressHere

# Facilitator
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Onchain Data
ALCHEMY_API_KEY=
BASESCAN_API_KEY=

# Social Data
SORSA_API_KEY=
TWITTERAPI_IO_KEY=

# ======================
# Gemini (for Reality Gap scoring)
# ======================
# Get free key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App
NEXT_PUBLIC_APP_URL=https://bepo-neon.vercel.app
