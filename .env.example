# ======================
# BEPO Environment Variables
# ======================

# Coinbase Developer Platform (for x402 facilitator)
# Get from: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Receiving wallet for x402 payments (your address on Base)
EVM_ADDRESS=0xYourWalletAddressHere

# Facilitator
# Testnet: https://x402.org/facilitator
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Onchain Data
ALCHEMY_API_KEY=
# Optional: Basescan
BASESCAN_API_KEY=

# Social Data (choose one)
SORSA_API_KEY=
# or
TWITTERAPI_IO_KEY=

# LLM for analysis summary (optional but recommended)
GOOGLE_AI_API_KEY=
# or
DEEPSEEK_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
